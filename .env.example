# Supabase
SUPABASE_URL=https://your-project.supabase.co/rest/v1/
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# WhatsApp Cloud API (Meta)
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_APP_SECRET=your-app-secret
WHATSAPP_BUSINESS_NUMBER=+5210000000000
WHATSAPP_TEMPLATE_HEADER_IMAGE_URL=https://your-cdn.com/image.png

# EasyLex
# IMPORTANT: la cuenta solo existe en PRODUCCIÓN. Los defaults en código apuntan
# a sandbox / dominios muertos; en prod hay que fijar estas dos explícitamente.
# EASYLEX_CALLBACK_URL debe terminar en /api/webhooks/easylex/sign y ser pública.
EASYLEX_ACCESS_KEY_ID=your-easylex-access-key-id
EASYLEX_SECRET_ACCESS_KEY=your-easylex-secret-access-key
EASYLEX_BASE_URL=https://api.easylex.com
EASYLEX_SIGNING_LINK_BASE_URL=https://easylex.com/documento/firma
EASYLEX_CALLBACK_URL=https://your-domain.com/api/webhooks/easylex/sign
EASYLEX_WEBHOOK_SECRET=your-easylex-webhook-secret

# App
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Secreto para firmar el token del link de auto-servicio /solicitar/<token>
# (el empleado abre el link, confirma y se genera su contrato). Cualquier cadena
# larga y aleatoria; debe ser estable (rotarla invalida los links ya enviados).
SOLICITAR_TOKEN_SECRET=your-long-random-solicitar-secret

# Plantilla de WhatsApp (aprobada en Meta, con un botón URL dinámico) para enviar
# el link de firma al empleado. El sufijo del link va en el botón ({{1}}); el
# cuerpo lleva 3 variables: nombre, monto y fecha límite. Default: adelanto_contrato_listo.
WHATSAPP_CONTRACT_TEMPLATE=adelanto_contrato_listo

# Versión de la Graph API de Meta (default v21.0) e idioma de plantillas
# (default es_MX). Configurables por si Meta rota versiones o se agregan
# plantillas en otro locale.
# WHATSAPP_GRAPH_VERSION=v21.0
# WHATSAPP_TEMPLATE_LANGUAGE=es_MX

# ---------------------------------------------------------------------------
# Roles y permisos (RBAC)
# ---------------------------------------------------------------------------
# Todos los perfiles nacen como `solo_lectura`. Estos correos se promueven a
# `admin` automáticamente al iniciar sesión. Sin esto no habría forma de
# designar al primer administrador salvo editando la base a mano.
BOOTSTRAP_ADMIN_EMAILS=tu@correo.com

# "warn" (por defecto) registra los accesos con rol insuficiente pero los deja
# pasar. "enforce" los bloquea con 403.
#
# Despliega primero en "warn", revisa en los logs el evento
# `auth.insufficient_role` para confirmar que los roles asignados son
# correctos, y solo entonces pasa a "enforce".
RBAC_ENFORCEMENT=warn

# Allow-list de dominios de correo para el login de Google (opt-in). Si se
# define, solo se admiten correos de esos dominios (separados por coma); un
# correo de otro dominio se rechaza en el callback. Vacía = sin restricción.
# Defensa en profundidad frente a un OAuth de Supabase permisivo + RBAC en warn.
# ALLOWED_EMAIL_DOMAINS=orbitware.com

# Lecturas del backoffice con RLS por sesión (fase B). Por defecto las lecturas
# usan la service role key (bypass de RLS), como siempre. Con "on" pasan al
# cliente de sesión y quedan sujetas a las políticas por rol.
#
# ORDEN OBLIGATORIO: aplicar antes la migración de políticas
# 20260722_rls_policies_phase_b.sql. Encender esto sin las políticas deja las
# lecturas bajo deny-all y devolvería cero filas.
RLS_SESSION_READS=off

# ---------------------------------------------------------------------------
# Observabilidad de errores (Sentry) — OPCIONAL
# ---------------------------------------------------------------------------
# Sin SENTRY_DSN, el SDK ni siquiera se carga: la aplicación se comporta igual
# que sin Sentry. Al ponerlo, logger.error/critical y los errores de servidor
# empiezan a reportarse automáticamente.

# DSN del proyecto (servidor). Se obtiene en Sentry → Project Settings → Client Keys.
SENTRY_DSN=

# DSN del cliente (navegador). Puede ser el mismo valor; va con prefijo público
# porque queda expuesto en el bundle (los DSN solo permiten enviar, no leer).
NEXT_PUBLIC_SENTRY_DSN=

# Entorno reportado (production, staging...). Por defecto usa NODE_ENV.
SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=

# Fracción de transacciones con tracing de rendimiento, 0 a 1. Por defecto 0
# (sin tracing): tiene coste y cuota, actívalo solo si lo necesitas.
SENTRY_TRACES_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0

# ---------------------------------------------------------------------------
# Cola de envío masivo (Google Cloud Tasks) — OPCIONAL
# ---------------------------------------------------------------------------
# Sin estas variables el envío masivo ocurre dentro del propio request, que es
# el comportamiento por defecto. Definiéndolas TODAS, el envío pasa a ser
# asíncrono: se encola una tarea por mensaje, con reintentos y límite de
# velocidad gestionados por la cola.
#
# El límite hacia Meta se configura en la cola con --max-dispatches-per-second,
# no en el código.
GCP_PROJECT_ID=
CLOUD_TASKS_LOCATION=us-central1
CLOUD_TASKS_QUEUE=whatsapp-bulk
# URL pública del propio servicio: Cloud Tasks hace POST contra ella.
TASKS_WORKER_BASE_URL=https://your-domain.com
# Service account con la que Cloud Tasks firma el token OIDC.
TASKS_INVOKER_SERVICE_ACCOUNT=cloud-tasks-invoker@your-project.iam.gserviceaccount.com

# Solo desarrollo: permite invocar el worker a mano con la cabecera
# x-tasks-secret. En producción se ignora y solo se acepta OIDC.
TASKS_WORKER_SECRET=

# Fuerza un driver concreto: "inline" | "cloud-tasks". Vacío = automático
# (cloud-tasks si la configuración de arriba está completa, inline si no).
# Útil para volver al envío síncrono sin desmontar la configuración de GCP.
QUEUE_DRIVER=

# ---------------------------------------------------------------------------
# Seguridad, Google y varios
# ---------------------------------------------------------------------------
# Clave secreta de Supabase (según el modo de despliegue).
# SUPABASE_SECRET_KEY=

# Allow-list de correos EXACTOS para el login (además de ALLOWED_EMAIL_DOMAINS).
# Separados por coma. Vacío = sin restricción por correo exacto.
# ALLOWED_EMAILS=

# Segunda señal para exigir firma de webhooks aunque NODE_ENV no sea "production".
# WEBHOOK_ENFORCE_SIGNATURES=true

# Nº de proxies de confianza al resolver la IP real (rate limiting). 1 = Cloud Run directo.
# TRUSTED_PROXY_COUNT=1

# Generación de contratos por Google Docs: rutas de los archivos de credenciales.
# Sin ellos NO se genera ningún contrato (ver docs/easylex-contratos.md).
# GOOGLE_OAUTH_CLIENT_PATH=google_oauth_client.json
# GOOGLE_TOKEN_PATH=token.json

# Solo desarrollo. WHATSAPP_DEBUG_AUTO_REPLY: auto-respuesta del webhook para pruebas.
# ENABLE_MOCK_SIGN: habilita /api/webhooks/easylex/mock-sign (jamás en producción).
# WHATSAPP_DEBUG_AUTO_REPLY=
# ENABLE_MOCK_SIGN=
