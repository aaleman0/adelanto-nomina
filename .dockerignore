# Dependencias e build: se reinstalan/regeneran dentro de la imagen. Copiar el
# node_modules del host traería binarios de macOS (sharp-darwin) que rompen en
# Linux.
node_modules
.next
out

# Secretos: NUNCA en la imagen. Se inyectan en runtime.
.env
.env.*

# Control de versiones y CI
.git
.github
.gitignore

# Tests y reportes
tests
test-results
playwright-report
coverage
vitest.config.ts
# Ojo: tsconfig.json incluye los *.ts de la raíz, así que `next build` los
# type-checkea. playwright.config.ts importa de ./tests/ (excluido arriba), de
# modo que dejarlo aquí ROMPE el build en el contenedor.
playwright.config.ts

# Documentación y scripts operativos (no se necesitan en runtime)
docs
scripts
*.md

# Basura del sistema / editor
.DS_Store
.vscode
.idea
npm-debug.log*
