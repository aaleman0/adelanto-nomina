{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "*.ts",
    "*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  // tests/ y scripts/ quedan fuera del build de Next a propósito: incluirlos
  // arrastraba los tipos de Playwright y de los scripts al chequeo de
  // `next build`, que llegaba a agotar el heap de 2 GB de Node.
  // Se siguen comprobando con `pnpm typecheck` vía tsconfig.check.json.
  "exclude": ["node_modules", "tests", "scripts", ".next"]
}
