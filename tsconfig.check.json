{
  // Chequeo de tipos completo: la app más tests, scripts y archivos de config.
  // Es el que usa `pnpm typecheck` y CI.
  //
  // El build de Next usa tsconfig.json, que deja fuera tests/ y scripts/ para
  // no agotar memoria (ver el comentario ahí).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": false
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "*.ts",
    "*.mts",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next"]
}
